#!/usr/bin/env bash
set -euo pipefail

CODE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${CODE_DIR}"

PYTHON="${PYTHON:-/root/vepfs/envs/neoverse/bin/python}"

usage() {
  cat <<'EOF'
NeoVerse local commands

Primary commands:
  ./cli train online [extra OmegaConf overrides...]
  ./cli train cache [extra OmegaConf overrides...]
  ./cli train fast [extra OmegaConf overrides...]
  ./cli cache build-camera [builder args]
  ./cli cache build-frozen [builder args]
  ./cli cache inspect [args]
  ./cli eval last CONFIG CHECKPOINT [dataset indices...]
  ./cli debug temporal [args]

Legacy aliases still work:
  ./cli train-online-time
  ./cli train-online-fast
  ./cli build-camera-cache
  ./cli build-frozen-cache
  ./cli compare-temporal
  ./cli eval-last
  ./cli dry-run-time

Useful env overrides:
  GPU_LIST=0,1
  RUN_NAME=train_cache
  MAX_STEPS=200000
  DATA_ROOT=data/SpatialVID_full
  FROZEN_CACHE_DIR=outputs/NeoVerseControlLatentDistill/frozen_cache
  CAMERA_CACHE_DIR=outputs/NeoVerseControlLatentDistill/camera_cache
  FIXED_CLIPS_PER_SCENE=16
  TRAJECTORIES_PER_CLIP=8|16
  FROZEN_CACHE_EVAL_RATIO=0.05
  EVAL_FREQ=500
  DRY_RUN=1
EOF
}

usage_train() {
  cat <<'EOF'
Usage:
  ./cli train online [extra OmegaConf overrides...]
  ./cli train cache [extra OmegaConf overrides...]
  ./cli train fast [extra OmegaConf overrides...]

Commands:
  online  Online SpatialVID training with temporal augmentation enabled.
  cache   Train directly from frozen_cache/*.pt with deterministic train/eval split.
  fast    Previous online_fast_gtcam-style run without temporal augmentation.
EOF
}

usage_cache() {
  cat <<'EOF'
Usage:
  ./cli cache build-camera [builder args]
  ./cli cache build-frozen [builder args]
  ./cli cache inspect [--cache_dir DIR] [--eval_ratio RATIO] [--sample N]

Commands:
  build-camera  Build fixed 81-frame camera caches.
  build-frozen  Build fixed clip + trajectory frozen forward caches.
  inspect       Report cache count, size, and deterministic train/eval split.
EOF
}

usage_eval() {
  cat <<'EOF'
Usage:
  ./cli eval last CONFIG CHECKPOINT [dataset indices...]
EOF
}

usage_debug() {
  cat <<'EOF'
Usage:
  ./cli debug temporal [args for compare_temporal_trajectories.py]
EOF
}

die() {
  echo "ERROR: $*" >&2
  exit 2
}

common_online_env() {
  export GPU_LIST="${GPU_LIST:-0,1}"
  export CAMERA_CONDITION_NORMALIZE="${CAMERA_CONDITION_NORMALIZE:-true}"
  export CAMERA_CONDITION_MIN_TRANSLATION_SCALE="${CAMERA_CONDITION_MIN_TRANSLATION_SCALE:-1.0}"
  export USE_CAMERA_ANNOTATIONS="${USE_CAMERA_ANNOTATIONS:-false}"
  export ENABLE_VRAM_MANAGEMENT="${ENABLE_VRAM_MANAGEMENT:-false}"
  export NUM_WORKERS="${NUM_WORKERS:-4}"
  export PIN_MEMORY="${PIN_MEMORY:-true}"
  export PERSISTENT_WORKERS="${PERSISTENT_WORKERS:-true}"
  export PREFETCH_FACTOR="${PREFETCH_FACTOR:-2}"
  export REUSE_RECONSTRUCTOR_TOKENS="${REUSE_RECONSTRUCTOR_TOKENS:-true}"
  export SKIP_UNUSED_RECONSTRUCTOR_HEADS="${SKIP_UNUSED_RECONSTRUCTOR_HEADS:-true}"
  export REUSE_CONTEXT_FORWARD_TOKENS="${REUSE_CONTEXT_FORWARD_TOKENS:-true}"
}

train_online() {
  common_online_env
  export RUN_NAME="${RUN_NAME:-online_time_forward_pause}"
  export TEMPORAL_AUGMENTATION="${TEMPORAL_AUGMENTATION:-true}"
  export TEMPORAL_TRAJECTORY_PROFILE="${TEMPORAL_TRAJECTORY_PROFILE:-forward_pause}"
  export TEMPORAL_VARIANT_PROFILE_WEIGHTS="${TEMPORAL_VARIANT_PROFILE_WEIGHTS:-forward_pause:0.5,mixed_fzr:0.4,backward:0.1}"
  export TEMPORAL_ORDER="${TEMPORAL_ORDER:-trajectory}"
  export TRAJECTORIES_PER_CLIP="${TRAJECTORIES_PER_CLIP:-8}"
  export DATASET_SEED="${DATASET_SEED:-0}"
  bash scripts/train_distill_control_latent_online.sh "$@"
}

train_fast() {
  common_online_env
  export RUN_NAME="${RUN_NAME:-online_fast_gtcam}"
  export TEMPORAL_AUGMENTATION="${TEMPORAL_AUGMENTATION:-false}"
  bash scripts/train_distill_control_latent_online.sh "$@"
}

train_cache() {
  common_online_env
  export RUN_NAME="${RUN_NAME:-train_cache}"
  export USE_FROZEN_CACHE="${USE_FROZEN_CACHE:-1}"
  export TRAIN_FROM_FROZEN_CACHE="${TRAIN_FROM_FROZEN_CACHE:-true}"
  export FROZEN_CACHE_SPLIT="${FROZEN_CACHE_SPLIT:-train}"
  export PRELOAD_FROZEN_CACHE="${PRELOAD_FROZEN_CACHE:-false}"
  export CACHE_FROZEN_OUTPUTS="${CACHE_FROZEN_OUTPUTS:-false}"
  bash scripts/train_distill_control_latent_online.sh "$@"
}

debug_temporal() {
  "${PYTHON}" experiments/compare_temporal_trajectories.py "$@"
}

cache_build_camera() {
  export GPU_LIST="${GPU_LIST:-0,1}"
  bash scripts/build_spatialvid_camera_cache.sh "$@"
}

cache_build_frozen() {
  export GPU_LIST="${GPU_LIST:-0,1}"
  bash scripts/build_spatialvid_frozen_cache.sh "$@"
}

cache_inspect() {
  "${PYTHON}" tools/cache/inspect_cache.py "$@"
}

eval_last() {
  if [[ "$#" -lt 2 ]]; then
    echo "Usage: ./cli eval last CONFIG CHECKPOINT [dataset indices...]" >&2
    exit 2
  fi
  local config="$1"
  local checkpoint="$2"
  shift 2
  local indices=("$@")
  if [[ "${#indices[@]}" -eq 0 ]]; then
    indices=(0 17 33 81 159 240 319)
  fi
  for index in "${indices[@]}"; do
    "${PYTHON}" eval_replace_teacher_with_student.py \
      "${config}" \
      "${checkpoint}" \
      --output_dir "$(dirname "${checkpoint}")/eval_idx${index}" \
      --dataset_index "${index}" \
      --modes teacher,student \
      --enable_vram_management
  done
}

dispatch_train() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help)
      usage_train
      ;;
    online|online-time|time)
      train_online "$@"
      ;;
    cache|frozen-cache)
      train_cache "$@"
      ;;
    fast|online-fast)
      train_fast "$@"
      ;;
    *)
      usage_train >&2
      die "Unknown train command: ${subcmd}"
      ;;
  esac
}

dispatch_cache() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help)
      usage_cache
      ;;
    build-camera|camera)
      cache_build_camera "$@"
      ;;
    build-frozen|frozen)
      cache_build_frozen "$@"
      ;;
    inspect|status)
      cache_inspect "$@"
      ;;
    *)
      usage_cache >&2
      die "Unknown cache command: ${subcmd}"
      ;;
  esac
}

dispatch_eval() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help)
      usage_eval
      ;;
    last)
      eval_last "$@"
      ;;
    *)
      usage_eval >&2
      die "Unknown eval command: ${subcmd}"
      ;;
  esac
}

dispatch_debug() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help)
      usage_debug
      ;;
    temporal)
      debug_temporal "$@"
      ;;
    *)
      usage_debug >&2
      die "Unknown debug command: ${subcmd}"
      ;;
  esac
}

cmd="${1:-help}"
if [[ "$#" -gt 0 ]]; then
  shift
fi

case "${cmd}" in
  help|-h|--help)
    usage
    ;;
  train)
    dispatch_train "$@"
    ;;
  cache)
    dispatch_cache "$@"
    ;;
  eval)
    dispatch_eval "$@"
    ;;
  debug)
    dispatch_debug "$@"
    ;;
  train-online-time)
    train_online "$@"
    ;;
  train-online-fast)
    train_fast "$@"
    ;;
  dry-run-time)
    DRY_RUN=1 train_online "$@"
    ;;
  compare-temporal)
    debug_temporal "$@"
    ;;
  build-camera-cache)
    cache_build_camera "$@"
    ;;
  build-frozen-cache)
    cache_build_frozen "$@"
    ;;
  eval-last)
    eval_last "$@"
    ;;
  *)
    echo "Unknown command: ${cmd}" >&2
    usage >&2
    exit 2
    ;;
esac
