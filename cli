#!/usr/bin/env bash
set -euo pipefail

CODE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${CODE_DIR}"

PYTHON="${PYTHON:-/root/vepfs/envs/neoverse/bin/python}"

usage() {
  cat <<'EOF'
NeoVerse local commands

Usage:
  ./cli train base CONFIG [args]
  ./cli train online [extra OmegaConf overrides...]
  ./cli train online-noaug [extra OmegaConf overrides...]
  ./cli train cache [extra OmegaConf overrides...]
  ./cli infer neoverse [args]
  ./cli app neoverse [args]
  ./cli app degradation [args]
  ./cli app wan-4step [args]
  ./cli cache build-camera [builder args]
  ./cli cache build-frozen [builder args]
  ./cli cache inspect [inspect args]
  ./cli eval last CONFIG CHECKPOINT [dataset indices...]
  ./cli eval generation-suite run|analyze|report|adapter-cache [args]
  ./cli profile distill-step [args]
  ./cli debug temporal [args]
  ./cli debug reconstruction [args]
  ./cli overfit conv|cross [extra OmegaConf overrides...]
  ./cli data prepare-spatialvid-hq [args]

Useful env overrides:
  GPU_LIST=0,1
  RUN_NAME=train_cache
  MAX_STEPS=200000
  DATA_ROOT=data/SpatialVID_full
  FROZEN_CACHE_DIR=outputs/NeoVerseControlLatentDistill/frozen_cache
  CAMERA_CACHE_DIR=outputs/NeoVerseControlLatentDistill/camera_cache
  FIXED_CLIPS_PER_SCENE=16
  TRAJECTORIES_PER_CLIP=8|16
  FROZEN_CACHE_EVAL_RATIO=0.05
  EVAL_FREQ=500
  DRY_RUN=1
EOF
}

usage_train() {
  cat <<'EOF'
Usage:
  ./cli train base CONFIG [args]
  ./cli train online [extra OmegaConf overrides...]
  ./cli train online-noaug [extra OmegaConf overrides...]
  ./cli train cache [extra OmegaConf overrides...]

Commands:
  base    Run the original NeoVerse training entry.
  online  Online SpatialVID training with temporal augmentation.
  online-noaug  Online training without temporal augmentation.
  cache   Train directly from frozen_cache/*.pt with deterministic train/eval split.
EOF
}

usage_infer() {
  cat <<'EOF'
Usage:
  ./cli infer neoverse [args]
EOF
}

usage_app() {
  cat <<'EOF'
Usage:
  ./cli app neoverse [args]
  ./cli app degradation [args]
  ./cli app wan-4step [args]
EOF
}

usage_cache() {
  cat <<'EOF'
Usage:
  ./cli cache build-camera [builder args]
  ./cli cache build-frozen [builder args]
  ./cli cache inspect [--cache_dir DIR] [--eval_ratio RATIO] [--sample N]
EOF
}

usage_eval() {
  cat <<'EOF'
Usage:
  ./cli eval last CONFIG CHECKPOINT [dataset indices...]
  ./cli eval generation-suite run|analyze|report|adapter-cache [args]
EOF
}

usage_generation_suite() {
  cat <<'EOF'
Usage:
  ./cli eval generation-suite run [args]
  ./cli eval generation-suite analyze [args]
  ./cli eval generation-suite report [args]
  ./cli eval generation-suite adapter-cache [args]
EOF
}

usage_profile() {
  cat <<'EOF'
Usage:
  ./cli profile distill-step [args]
EOF
}

usage_debug() {
  cat <<'EOF'
Usage:
  ./cli debug temporal [args]
  ./cli debug reconstruction [args]
EOF
}

usage_overfit() {
  cat <<'EOF'
Usage:
  ./cli overfit conv [extra OmegaConf overrides...]
  ./cli overfit cross [extra OmegaConf overrides...]
EOF
}

usage_data() {
  cat <<'EOF'
Usage:
  ./cli data prepare-spatialvid-hq [args]
EOF
}

die() {
  echo "ERROR: $*" >&2
  exit 2
}

common_online_env() {
  export GPU_LIST="${GPU_LIST:-${CUDA_VISIBLE_DEVICES:-}}"
  export CAMERA_CONDITION_NORMALIZE="${CAMERA_CONDITION_NORMALIZE:-true}"
  export CAMERA_CONDITION_MIN_TRANSLATION_SCALE="${CAMERA_CONDITION_MIN_TRANSLATION_SCALE:-1.0}"
  export USE_CAMERA_ANNOTATIONS="${USE_CAMERA_ANNOTATIONS:-false}"
  export ENABLE_VRAM_MANAGEMENT="${ENABLE_VRAM_MANAGEMENT:-false}"
  export NUM_WORKERS="${NUM_WORKERS:-4}"
  export PIN_MEMORY="${PIN_MEMORY:-true}"
  export PERSISTENT_WORKERS="${PERSISTENT_WORKERS:-true}"
  export PREFETCH_FACTOR="${PREFETCH_FACTOR:-2}"
  export REUSE_RECONSTRUCTOR_TOKENS="${REUSE_RECONSTRUCTOR_TOKENS:-true}"
  export SKIP_UNUSED_RECONSTRUCTOR_HEADS="${SKIP_UNUSED_RECONSTRUCTOR_HEADS:-true}"
  export REUSE_CONTEXT_FORWARD_TOKENS="${REUSE_CONTEXT_FORWARD_TOKENS:-true}"
}

disable_frozen_cache() {
  export TRAIN_FROM_FROZEN_CACHE="${TRAIN_FROM_FROZEN_CACHE:-false}"
  export FROZEN_CACHE_READ="${FROZEN_CACHE_READ:-false}"
  export FROZEN_CACHE_WRITE="${FROZEN_CACHE_WRITE:-false}"
  export FROZEN_CACHE_REQUIRED="${FROZEN_CACHE_REQUIRED:-false}"
  export PRELOAD_FROZEN_CACHE="${PRELOAD_FROZEN_CACHE:-false}"
  export CACHE_FROZEN_OUTPUTS="${CACHE_FROZEN_OUTPUTS:-false}"
}

launch_train() {
  bash scripts/launch/train_distill.sh "$@"
}

train_base() {
  "${PYTHON}" tools/train/base_train.py "$@"
}

train_online() {
  common_online_env
  disable_frozen_cache
  export RUN_NAME="${RUN_NAME:-online_time_forward_pause}"
  export CONTEXT_SAMPLING_STRATEGY="${CONTEXT_SAMPLING_STRATEGY:-mixed}"
  export TEMPORAL_AUGMENTATION="${TEMPORAL_AUGMENTATION:-true}"
  export TEMPORAL_TRAJECTORY_PROFILE="${TEMPORAL_TRAJECTORY_PROFILE:-forward_pause}"
  export TEMPORAL_VARIANT_PROFILE_WEIGHTS="${TEMPORAL_VARIANT_PROFILE_WEIGHTS:-forward_pause:0.5,mixed_fzr:0.4,backward:0.1}"
  export TEMPORAL_ORDER="${TEMPORAL_ORDER:-trajectory}"
  export TRAJECTORIES_PER_CLIP="${TRAJECTORIES_PER_CLIP:-8}"
  export DATASET_SEED="${DATASET_SEED:-0}"
  launch_train "$@"
}

train_cache() {
  common_online_env
  export RUN_NAME="${RUN_NAME:-train_cache}"
  export CONTEXT_SAMPLING_STRATEGY="${CONTEXT_SAMPLING_STRATEGY:-mixed}"
  export DATASET_SEED="${DATASET_SEED:-null}"
  export FROZEN_CACHE_DIR="${FROZEN_CACHE_DIR:-${CODE_DIR}/outputs/NeoVerseControlLatentDistill/frozen_cache}"
  export TRAIN_FROM_FROZEN_CACHE="${TRAIN_FROM_FROZEN_CACHE:-true}"
  export FROZEN_CACHE_SPLIT="${FROZEN_CACHE_SPLIT:-train}"
  export FROZEN_CACHE_READ="${FROZEN_CACHE_READ:-true}"
  export FROZEN_CACHE_WRITE="${FROZEN_CACHE_WRITE:-false}"
  export FROZEN_CACHE_REQUIRED="${FROZEN_CACHE_REQUIRED:-true}"
  export PRELOAD_FROZEN_CACHE="${PRELOAD_FROZEN_CACHE:-false}"
  export CACHE_FROZEN_OUTPUTS="${CACHE_FROZEN_OUTPUTS:-false}"
  launch_train "$@"
}

train_online_noaug() {
  common_online_env
  disable_frozen_cache
  export RUN_NAME="${RUN_NAME:-online_noaug}"
  export CONTEXT_SAMPLING_STRATEGY="${CONTEXT_SAMPLING_STRATEGY:-mixed}"
  export TEMPORAL_AUGMENTATION="${TEMPORAL_AUGMENTATION:-false}"
  export DATASET_SEED="${DATASET_SEED:-null}"
  launch_train "$@"
}

cache_build_camera() {
  bash scripts/launch/build_camera_cache.sh "$@"
}

cache_build_frozen() {
  bash scripts/launch/build_frozen_cache.sh "$@"
}

cache_inspect() {
  "${PYTHON}" tools/cache/inspect_cache.py "$@"
}

eval_last() {
  if [[ "$#" -lt 2 ]]; then
    usage_eval >&2
    exit 2
  fi
  local config="$1"
  local checkpoint="$2"
  shift 2
  local indices=("$@")
  if [[ "${#indices[@]}" -eq 0 ]]; then
    indices=(0 17 33 81 159 240 319)
  fi
  for index in "${indices[@]}"; do
    "${PYTHON}" tools/eval/render_student_comparison.py \
      "${config}" \
      "${checkpoint}" \
      --output_dir "$(dirname "${checkpoint}")/eval_idx${index}" \
      --dataset_index "${index}" \
      --modes teacher,student \
      --enable_vram_management
  done
}

eval_generation_suite() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_generation_suite ;;
    run) "${PYTHON}" experiments/archive/midterm/run_generation_suite.py "$@" ;;
    analyze) "${PYTHON}" experiments/archive/midterm/analyze_generation_suite.py "$@" ;;
    report) "${PYTHON}" experiments/archive/midterm/report_generation_suite.py "$@" ;;
    adapter-cache) "${PYTHON}" experiments/archive/midterm/adapter_cache_eval.py "$@" ;;
    *) usage_generation_suite >&2; die "Unknown generation-suite command: ${subcmd}" ;;
  esac
}

debug_temporal() {
  "${PYTHON}" tools/diagnostics/compare_temporal_trajectories.py "$@"
}

debug_reconstruction() {
  bash scripts/launch/compare_reconstruction_context.sh "$@"
}

overfit_conv() {
  bash scripts/overfit/conv_gpu0.sh "$@"
}

overfit_cross() {
  bash scripts/overfit/cross_gpu1.sh "$@"
}

data_prepare_spatialvid_hq() {
  bash scripts/data/prepare_spatialvid_hq.sh "$@"
}

profile_distill_step() {
  "${PYTHON}" tools/profile/distill_step.py "$@"
}

infer_neoverse() {
  "${PYTHON}" tools/inference/neoverse_inference.py "$@"
}

app_neoverse() {
  "${PYTHON}" tools/apps/neoverse_app.py "$@"
}

app_degradation() {
  "${PYTHON}" tools/apps/degradation_gradio.py "$@"
}

app_wan_4step() {
  "${PYTHON}" tools/apps/wan_4step_gradio.py "$@"
}

dispatch_train() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_train ;;
    base) train_base "$@" ;;
    online) train_online "$@" ;;
    online-noaug) train_online_noaug "$@" ;;
    cache) train_cache "$@" ;;
    *) usage_train >&2; die "Unknown train command: ${subcmd}" ;;
  esac
}

dispatch_infer() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_infer ;;
    neoverse) infer_neoverse "$@" ;;
    *) usage_infer >&2; die "Unknown infer command: ${subcmd}" ;;
  esac
}

dispatch_app() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_app ;;
    neoverse) app_neoverse "$@" ;;
    degradation) app_degradation "$@" ;;
    wan-4step) app_wan_4step "$@" ;;
    *) usage_app >&2; die "Unknown app command: ${subcmd}" ;;
  esac
}

dispatch_cache() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_cache ;;
    build-camera) cache_build_camera "$@" ;;
    build-frozen) cache_build_frozen "$@" ;;
    inspect) cache_inspect "$@" ;;
    *) usage_cache >&2; die "Unknown cache command: ${subcmd}" ;;
  esac
}

dispatch_eval() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_eval ;;
    last) eval_last "$@" ;;
    generation-suite) eval_generation_suite "$@" ;;
    *) usage_eval >&2; die "Unknown eval command: ${subcmd}" ;;
  esac
}

dispatch_profile() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_profile ;;
    distill-step) profile_distill_step "$@" ;;
    *) usage_profile >&2; die "Unknown profile command: ${subcmd}" ;;
  esac
}

dispatch_debug() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_debug ;;
    temporal) debug_temporal "$@" ;;
    reconstruction) debug_reconstruction "$@" ;;
    *) usage_debug >&2; die "Unknown debug command: ${subcmd}" ;;
  esac
}

dispatch_overfit() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_overfit ;;
    conv) overfit_conv "$@" ;;
    cross) overfit_cross "$@" ;;
    *) usage_overfit >&2; die "Unknown overfit command: ${subcmd}" ;;
  esac
}

dispatch_data() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_data ;;
    prepare-spatialvid-hq) data_prepare_spatialvid_hq "$@" ;;
    *) usage_data >&2; die "Unknown data command: ${subcmd}" ;;
  esac
}

cmd="${1:-help}"
if [[ "$#" -gt 0 ]]; then
  shift
fi

case "${cmd}" in
  help|-h|--help) usage ;;
  train) dispatch_train "$@" ;;
  infer) dispatch_infer "$@" ;;
  app) dispatch_app "$@" ;;
  cache) dispatch_cache "$@" ;;
  eval) dispatch_eval "$@" ;;
  profile) dispatch_profile "$@" ;;
  debug) dispatch_debug "$@" ;;
  overfit) dispatch_overfit "$@" ;;
  data) dispatch_data "$@" ;;
  *) usage >&2; die "Unknown command: ${cmd}" ;;
esac
