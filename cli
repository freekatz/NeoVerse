  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_overfit ;;
    conv) overfit_conv "$@" ;;
    cross) overfit_cross "$@" ;;
    *) usage_overfit >&2; die "Unknown overfit command: ${subcmd}" ;;
  esac
}

dispatch_data() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_data ;;
    prepare-spatialvid-hq) data_prepare_spatialvid_hq "$@" ;;
    *) usage_data >&2; die "Unknown data command: ${subcmd}" ;;
  esac
}

dispatch_dev_train() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_dev_train ;;
    online) train_online "$@" ;;
    online-noaug) train_online_noaug "$@" ;;
    *) usage_dev_train >&2; die "Unknown dev train command: ${subcmd}" ;;
  esac
}

dispatch_dev_app() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_dev_app ;;
    degradation) app_degradation "$@" ;;
    wan-4step) app_wan_4step "$@" ;;
    *) usage_dev_app >&2; die "Unknown dev app command: ${subcmd}" ;;
  esac
}

dispatch_dev() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_dev ;;
    train) dispatch_dev_train "$@" ;;
    profile) dispatch_profile "$@" ;;
    debug) dispatch_debug "$@" ;;
    overfit) dispatch_overfit "$@" ;;
    data) dispatch_data "$@" ;;
    app) dispatch_dev_app "$@" ;;
    *) usage_dev >&2; die "Unknown dev command: ${subcmd}" ;;
  esac
}

dispatch_legacy() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_legacy ;;
    train-base) train_base "$@" ;;
    *) usage_legacy >&2; die "Unknown legacy command: ${subcmd}" ;;
  esac
}

cmd="${1:-help}"
if [[ "$#" -gt 0 ]]; then
  shift
fi

case "${cmd}" in
  help|-h|--help) usage ;;
  train) dispatch_train "$@" ;;
  infer) dispatch_infer "$@" ;;
  app) dispatch_app "$@" ;;
  cache) dispatch_cache "$@" ;;
  eval) dispatch_eval "$@" ;;
  volc) dispatch_volc "$@" ;;
  dev) dispatch_dev "$@" ;;
  legacy) dispatch_legacy "$@" ;;
  *) usage >&2; die "Unknown command: ${cmd}" ;;
esac
