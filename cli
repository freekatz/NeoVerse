dispatch_profile() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_profile ;;
    distill-step) profile_distill_step "$@" ;;
