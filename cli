dispatch_debug() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_debug ;;
    temporal) debug_temporal "$@" ;;
    reconstruction) debug_reconstruction "$@" ;;
    *) usage_debug >&2; die "Unknown debug command: ${subcmd}" ;;
  esac
