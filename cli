#!/usr/bin/env bash
set -euo pipefail

CODE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${CODE_DIR}"

PYTHON="${PYTHON:-/root/vepfs/envs/neoverse/bin/python}"

usage() {
  cat <<'EOF'
NeoVerse local commands

Stable user paths:
  ./cli train cache [extra OmegaConf overrides...]
  ./cli infer neoverse [args]
  ./cli app neoverse [args]
  ./cli cache build-camera [builder args]
  ./cli cache build-frozen [builder args]
  ./cli cache inspect [inspect args]
  ./cli eval frozen-cache CONFIG CHECKPOINT [metric args...]
  ./cli eval last CONFIG CHECKPOINT [dataset indices...]  # legacy visual smoke test
  ./cli volc auth import [AccessKey.txt]
  ./cli volc submit train-cache|build-camera|build-frozen [args]

Development paths:
  ./cli train online|online-noaug [extra OmegaConf overrides...]
  ./cli dev profile distill-step [args]
  ./cli dev debug temporal|reconstruction [args]
  ./cli dev overfit conv|cross [extra OmegaConf overrides...]
  ./cli dev data prepare-spatialvid-hq [args]
  ./cli dev app degradation|wan-4step [args]
  ./cli legacy train-base CONFIG [args]

Useful env overrides:
  GPU_LIST=0,1
  RUN_NAME=train_cache
  MAX_STEPS=200000
  DATA_ROOT=data/SpatialVID
  FROZEN_CACHE_DIR=outputs/NeoVerseControlLatentDistill/frozen_cache
  CAMERA_CACHE_DIR=outputs/NeoVerseControlLatentDistill/camera_cache
  FIXED_CLIPS_PER_SCENE=16
  TRAJECTORIES_PER_CLIP=8|16
  FROZEN_CACHE_EVAL_RATIO=0.05
  EVAL_FREQ=500
  DRY_RUN=1
EOF
}

usage_train() {
  cat <<'EOF'
Usage:
  ./cli train cache [extra OmegaConf overrides...]
  ./cli train online [extra OmegaConf overrides...]
  ./cli train online-noaug [extra OmegaConf overrides...]

Commands:
  cache   Train directly from frozen_cache/*.pt with deterministic train/eval split.
  online  Dev path: online SpatialVID training with temporal augmentation.
  online-noaug  Dev path: online training without temporal augmentation.
EOF
}

usage_infer() {
  cat <<'EOF'
Usage:
  ./cli infer neoverse [args]
EOF
}

usage_app() {
  cat <<'EOF'
Usage:
  ./cli app neoverse [args]

Development app commands:
  ./cli dev app degradation [args]
  ./cli dev app wan-4step [args]
EOF
}

usage_cache() {
  cat <<'EOF'
Usage:
  ./cli cache build-camera [builder args]
  ./cli cache build-frozen [builder args]
  ./cli cache inspect [--cache_dir DIR] [--eval_ratio RATIO] [--sample N]
EOF
}

usage_eval() {
  cat <<'EOF'
Usage:
  ./cli eval frozen-cache CONFIG CHECKPOINT [metric args...]
  ./cli eval val CONFIG CHECKPOINT [metric args...]
  ./cli eval last CONFIG CHECKPOINT [dataset indices...]  # legacy visual smoke test

Examples:
  ./cli eval frozen-cache outputs/.../config.yaml outputs/.../adapter_last.pt
  ./cli eval frozen-cache outputs/.../config.yaml outputs/.../adapter_last.pt --max_samples 8 --modes student
EOF
}

usage_profile() {
  cat <<'EOF'
Usage:
  ./cli dev profile distill-step [args]
EOF
}

usage_volc() {
  cat <<'EOF'
Usage:
  ./cli volc auth import [AccessKey.txt]
  ./cli volc submit train-cache|build-camera|build-frozen [args]

Common env:
  VOLC_RESOURCE_QUEUE_NAME
  VOLC_IMAGE_URL
  VOLC_FLAVOR
  VOLC_VEPFS_ID
  DRY_RUN=1
EOF
}

usage_debug() {
  cat <<'EOF'
Usage:
  ./cli dev debug temporal [args]
  ./cli dev debug reconstruction [args]
EOF
}

usage_overfit() {
  cat <<'EOF'
Usage:
  ./cli dev overfit conv [extra OmegaConf overrides...]
  ./cli dev overfit cross [extra OmegaConf overrides...]
EOF
}

usage_data() {
  cat <<'EOF'
Usage:
  ./cli dev data prepare-spatialvid-hq [args]
EOF
}

usage_dev() {
  cat <<'EOF'
Usage:
  ./cli dev train online [extra OmegaConf overrides...]
  ./cli dev train online-noaug [extra OmegaConf overrides...]
  ./cli dev profile distill-step [args]
  ./cli dev debug temporal|reconstruction [args]
  ./cli dev overfit conv|cross [extra OmegaConf overrides...]
  ./cli dev data prepare-spatialvid-hq [args]
  ./cli dev app degradation|wan-4step [args]
EOF
}

usage_dev_train() {
  cat <<'EOF'
Usage:
  ./cli dev train online [extra OmegaConf overrides...]
  ./cli dev train online-noaug [extra OmegaConf overrides...]
EOF
}

usage_dev_app() {
  cat <<'EOF'
Usage:
  ./cli dev app degradation [args]
  ./cli dev app wan-4step [args]
EOF
}

usage_legacy() {
  cat <<'EOF'
Usage:
  ./cli legacy train-base CONFIG [args]
EOF
}

die() {
  echo "ERROR: $*" >&2
  exit 2
}

common_online_env() {
  export GPU_LIST="${GPU_LIST:-${CUDA_VISIBLE_DEVICES:-}}"
  export CAMERA_CONDITION_NORMALIZE="${CAMERA_CONDITION_NORMALIZE:-true}"
  export CAMERA_CONDITION_MIN_TRANSLATION_SCALE="${CAMERA_CONDITION_MIN_TRANSLATION_SCALE:-1.0}"
  export USE_CAMERA_ANNOTATIONS="${USE_CAMERA_ANNOTATIONS:-false}"
  export ENABLE_VRAM_MANAGEMENT="${ENABLE_VRAM_MANAGEMENT:-false}"
  export NUM_WORKERS="${NUM_WORKERS:-4}"
  export PIN_MEMORY="${PIN_MEMORY:-true}"
  export PERSISTENT_WORKERS="${PERSISTENT_WORKERS:-true}"
  export PREFETCH_FACTOR="${PREFETCH_FACTOR:-2}"
  export REUSE_RECONSTRUCTOR_TOKENS="${REUSE_RECONSTRUCTOR_TOKENS:-true}"
  export SKIP_UNUSED_RECONSTRUCTOR_HEADS="${SKIP_UNUSED_RECONSTRUCTOR_HEADS:-true}"
  export REUSE_CONTEXT_FORWARD_TOKENS="${REUSE_CONTEXT_FORWARD_TOKENS:-true}"
}

disable_frozen_cache() {
  export TRAIN_FROM_FROZEN_CACHE="false"
  export FROZEN_CACHE_READ="false"
  export FROZEN_CACHE_WRITE="false"
  export FROZEN_CACHE_REQUIRED="false"
  export PRELOAD_FROZEN_CACHE="false"
  export CACHE_FROZEN_OUTPUTS="false"
}

launch_train() {
  bash scripts/launch/train_distill.sh "$@"
}

train_base() {
  "${PYTHON}" tools/train/base_train.py "$@"
}

train_online() {
  common_online_env
  disable_frozen_cache
  export RUN_NAME="${RUN_NAME:-online_time_forward_pause}"
  export CONTEXT_SAMPLING_STRATEGY="${CONTEXT_SAMPLING_STRATEGY:-mixed}"
  export TEMPORAL_AUGMENTATION="${TEMPORAL_AUGMENTATION:-true}"
  export TEMPORAL_TRAJECTORY_PROFILE="${TEMPORAL_TRAJECTORY_PROFILE:-forward_pause}"
  export TEMPORAL_VARIANT_PROFILE_WEIGHTS="${TEMPORAL_VARIANT_PROFILE_WEIGHTS:-forward_pause:0.5,mixed_fzr:0.4,backward:0.1}"
  export TEMPORAL_ORDER="${TEMPORAL_ORDER:-trajectory}"
  export TRAJECTORIES_PER_CLIP="${TRAJECTORIES_PER_CLIP:-8}"
  export DATASET_SEED="${DATASET_SEED:-0}"
  launch_train "$@"
}

train_cache() {
  common_online_env
  export RUN_NAME="${RUN_NAME:-train_cache}"
  export CONTEXT_SAMPLING_STRATEGY="${CONTEXT_SAMPLING_STRATEGY:-mixed}"
  export DATASET_SEED="${DATASET_SEED:-null}"
  export FROZEN_CACHE_DIR="${FROZEN_CACHE_DIR:-${CODE_DIR}/outputs/NeoVerseControlLatentDistill/frozen_cache}"
  export TRAIN_FROM_FROZEN_CACHE="true"
  export FROZEN_CACHE_SPLIT="${FROZEN_CACHE_SPLIT:-train}"
  export FROZEN_CACHE_READ="true"
  export FROZEN_CACHE_WRITE="false"
  export FROZEN_CACHE_REQUIRED="true"
  export PRELOAD_FROZEN_CACHE="${PRELOAD_FROZEN_CACHE:-false}"
  export CACHE_FROZEN_OUTPUTS="${CACHE_FROZEN_OUTPUTS:-false}"
  launch_train "$@"
}

train_online_noaug() {
  common_online_env
  disable_frozen_cache
  export RUN_NAME="${RUN_NAME:-online_noaug}"
  export CONTEXT_SAMPLING_STRATEGY="${CONTEXT_SAMPLING_STRATEGY:-mixed}"
  export TEMPORAL_AUGMENTATION="${TEMPORAL_AUGMENTATION:-false}"
  export DATASET_SEED="${DATASET_SEED:-null}"
  launch_train "$@"
}

cache_build_camera() {
  bash scripts/launch/build_camera_cache.sh "$@"
}

cache_build_frozen() {
  bash scripts/launch/build_frozen_cache.sh "$@"
}

cache_inspect() {
  "${PYTHON}" tools/cache/inspect_cache.py "$@"
}

eval_last() {
  if [[ "$#" -lt 2 ]]; then
    usage_eval >&2
    exit 2
  fi
  local config="$1"
  local checkpoint="$2"
  shift 2
  local indices=("$@")
  if [[ "${#indices[@]}" -eq 0 ]]; then
    indices=(0 17 33 81 159 240 319)
  fi
  for index in "${indices[@]}"; do
    "${PYTHON}" tools/eval/render_student_comparison.py \
      "${config}" \
      "${checkpoint}" \
      --output_dir "$(dirname "${checkpoint}")/eval_idx${index}" \
      --dataset_index "${index}" \
      --modes teacher,student \
      --enable_vram_management
  done
}

eval_frozen_cache() {
  if [[ "$#" -lt 2 ]]; then
    usage_eval >&2
    exit 2
  fi
  "${PYTHON}" tools/eval/evaluate_frozen_cache_metrics.py "$@"
}

debug_temporal() {
  "${PYTHON}" tools/diagnostics/compare_temporal_trajectories.py "$@"
}

debug_reconstruction() {
  bash scripts/launch/compare_reconstruction_context.sh "$@"
}

overfit_conv() {
  bash scripts/overfit/conv_gpu0.sh "$@"
}

overfit_cross() {
  bash scripts/overfit/cross_gpu1.sh "$@"
}

data_prepare_spatialvid_hq() {
  bash scripts/data/prepare_spatialvid_hq.sh "$@"
}

profile_distill_step() {
  "${PYTHON}" tools/profile/distill_step.py "$@"
}

load_volc_env_local() {
  local env_file="${VOLC_ENV_FILE:-${CODE_DIR}/deploy/volc/env.local}"
  if [[ -f "${env_file}" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "${env_file}"
    set +a
  fi
}

volc_auth() {
  "${PYTHON}" tools/volc/import_auth.py "$@"
}

volc_submit() {
  if [[ "$#" -lt 1 ]]; then
    usage_volc >&2
    exit 2
  fi
  load_volc_env_local
  "${PYTHON}" tools/volc/submit_job.py "$@"
}

infer_neoverse() {
  "${PYTHON}" tools/inference/neoverse_inference.py "$@"
}

app_neoverse() {
  "${PYTHON}" tools/apps/neoverse_app.py "$@"
}

app_degradation() {
  "${PYTHON}" tools/apps/degradation_gradio.py "$@"
}

app_wan_4step() {
  "${PYTHON}" tools/apps/wan_4step_gradio.py "$@"
}

dispatch_train() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_train ;;
    online) train_online "$@" ;;
    online-noaug) train_online_noaug "$@" ;;
    cache) train_cache "$@" ;;
    *) usage_train >&2; die "Unknown train command: ${subcmd}" ;;
  esac
}

dispatch_infer() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_infer ;;
    neoverse) infer_neoverse "$@" ;;
    *) usage_infer >&2; die "Unknown infer command: ${subcmd}" ;;
  esac
}

dispatch_app() {
  local subcmd="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi
  case "${subcmd}" in
    help|-h|--help) usage_app ;;
    neoverse) app_neoverse "$@" ;;
    *) usage_app >&2; die "Unknown app command: ${subcmd}" ;;
