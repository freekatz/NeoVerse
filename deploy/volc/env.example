# Copy this file to deploy/volc/env.local for local defaults.
# Do not put AccessKeyId/SecretAccessKey here. Import credentials with:
#   ./cli volc auth import ../AccessKey.txt

export VOLC_PROJECT_NAME=default
export VOLC_RESOURCE_QUEUE_ID=q-20260318205115-lvfng
export VOLC_RESOURCE_QUEUE_NAME=queue010
export VOLC_IMAGE_URL=cr-mlp-cn-beijing.cr.volces.com/public/cmh_test:1.5
export VOLC_FRAMEWORK=PyTorchDDP
export VOLC_PRIORITY=6
export VOLC_PREEMPTIBLE=true
export VOLC_ENABLE_RETRY=true
export VOLC_MAX_RETRY_TIMES=5
export VOLC_RETRY_INTERVAL_SECONDS=120
export VOLC_RETRY_POLICY_SETS=Failed
export VOLC_ROLE_NAME=worker
export VOLC_REPLICAS=2
export VOLC_FLAVOR=ml.pni2.28xlarge
export VOLC_LOCAL_DIFF=off

# Optional storage mount. Recommended if code/data/models live on vePFS.
export VOLC_VEPFS_ID=vepfs-cnbj2c98dea54433
export VOLC_VEPFS_SUB_PATH=/queue010/20252203747
export VOLC_VEPFS_MOUNT_PATH=/root/vepfs

# Optional command defaults passed into the job runtime.
export DATA_ROOT=data/SpatialVID
export FROZEN_CACHE_DIR=outputs/NeoVerseControlLatentDistill/frozen_cache
export CAMERA_CACHE_DIR=outputs/NeoVerseControlLatentDistill/camera_cache
export FIXED_CLIPS_PER_SCENE=16
export TRAJECTORIES_PER_CLIP=8

# SwanLab logging. Use SWANLAB_MODE=cloud with SWANLAB_API_KEY for online sync.
export SWANLAB_MODE=cloud
export SWANLAB_PROJECT=NeoVerseControlLatentDistill
